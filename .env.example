APP_NAME="CodeSense AI API"
ENV="development"
DEBUG=true
API_PREFIX="/api/v1"

# Required for LLM-powered review (free tier at https://console.groq.com)
GROQ_API_KEY=""

# Optional for public repos and pull requests; raises GitHub rate limits.
# Required to post pull request review comments (fine-grained token with "Pull requests: Read and write").
GITHUB_TOKEN=""

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Hard cap on files reviewed per repository or pull request (one LLM call per file)
MAX_REPO_FILES=50
# Largest pasted code snippet accepted, in characters
MAX_CODE_CHARS=100000

LLM_MODEL="openai/gpt-oss-120b"
LLM_FALLBACK_MODEL="openai/gpt-oss-20b"
